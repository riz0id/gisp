(define (ascribe# append
                  (@fun (@prod (@list @int) (@list @int)) (@list @int)))
  (lambda ((ascribe# xs (@list @int)) (ascribe# ys (@list @int)))
    (match xs
      ((nil (prod#)) ys)
      ((cons (prod# x rest)) (cons (prod# x (append rest ys)))))))

(define (ascribe# keep-le (@fun (@prod @int (@list @int)) (@list @int)))
  (lambda ((ascribe# p @int) (ascribe# xs (@list @int)))
    (match xs
      ((nil (prod#)) xs)
      ((cons (prod# x rest))
       (match (le x p)
         ((#t (prod#)) (cons (prod# x (keep-le p rest))))
         ((#f (prod#)) (keep-le p rest)))))))

(define (ascribe# keep-gt (@fun (@prod @int (@list @int)) (@list @int)))
  (lambda ((ascribe# p @int) (ascribe# xs (@list @int)))
    (match xs
      ((nil (prod#)) xs)
      ((cons (prod# x rest))
       (match (le x p)
         ((#t (prod#)) (keep-gt p rest))
         ((#f (prod#)) (cons (prod# x (keep-gt p rest)))))))))

(define (ascribe# sort (@fun (@prod (@list @int)) (@list @int)))
  (lambda ((ascribe# xs (@list @int)))
    (match xs
      ((nil (prod#)) xs)
      ((cons (prod# x (nil (prod#)))) xs)
      ((cons (prod# x rest))
       (append (sort (keep-le x rest))
               (cons (prod# x (sort (keep-gt x rest)))))))))

(sort '(3 1 4 1 5 9 2 6))
