(define pass
  (lambda (xs)
    (if (le (len xs) 1)
        xs
        (if (le (head xs) (head (tail xs)))
            (. (head xs) (pass (tail xs)))
            (. (head (tail xs)) (pass (. (head xs) (tail (tail xs)))))))))

(define sort
  (lambda (xs)
    (letrec ((ys (pass xs)))
      (if (eq xs ys)
          xs
          (sort ys)))))

(sort '(3 1 4 1 5 9 2 6))
